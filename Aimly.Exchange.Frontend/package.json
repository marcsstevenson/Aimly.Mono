{
  "name": "aimly-exchange",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tailwind": "npx tailwindcss -i ./src/css/input.css -o ./src/css/output.css --watch",
    "relay": "relay-compiler",
    "schema": "get-graphql-schema http://localhost:7071/api/graphqlschema > aimly-backend.schema.graphql",
    "lint:imports": "eslint \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "relay": {
    "src": "./src/",
    "schema": "./aimly-backend.schema.graphql",
    "artifactDirectory": "./src/__generated__",
    "language": "typescript",
    "exclude": [
      "**/node_modules/**",
      "**/__mocks__/**",
      "**/__generated__/**"
    ]
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.2.4",
    "@headlessui/react": "^1.7.15",
    "@heroicons/react": "^2.0.18",
    "@microsoft/signalr": "^7.0.5",
    "@sendbird/uikit-react": "^3.6.2",
    "@tailwindcss/forms": "^0.5.2",
    "@tiptap/extension-image": "^2.4.0",
    "@tiptap/extension-text-align": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "@types/react": "^18.2.13",
    "@types/react-dom": "^18.2.6",
    "@types/react-relay": "^14.1.4",
    "@types/react-router-dom": "^5.3.2",
    "dompurify": "^2.3.8",
    "formik": "^2.2.9",
    "lodash.debounce": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga": "^3.3.1",
    "react-relay": "^16.0.0",
    "react-router-dom": "^6.2.1",
    "relay-runtime": "^16.0.0",
    "sass": "^1.49.9",
    "timezones-list": "^3.0.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@eslint/js": "^9.21.0",
    "@tailwindcss/typography": "^0.5.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^10.4.9",
    "@types/dompurify": "^2.3.3",
    "@types/lodash.debounce": "^4.0.6",
    "@types/react-currency-format": "^1.0.0",
    "@vitejs/plugin-legacy": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.0",
    "babel-plugin-relay": "^16.0.0",
    "eslint": "^9.21.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^16.0.0",
    "jest-fetch-mock": "^3.0.3",
    "postcss": "^8.4.5",
    "prettier": "^2.5.1",
    "prettier-plugin-tailwindcss": "^0.1.11",
    "regenerator-runtime": "^0.14.1",
    "relay-compiler": "^16.0.0",
    "tailwindcss": "^3.1.4",
    "typescript": "^4.5.5",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
